# J1/D318: stop only new N50 WS timer and restore original N2 fallback.
# This is root-owned and must not be installed until release gate.
[Unit]
Description=CIA J1 N50 WS fallback to existing N2 research timer
After=cia-j1-n50-ws.service

[Service]
Type=oneshot
User=root
NoNewPrivileges=true
ProtectHome=read-only
ProtectSystem=strict
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX
TimeoutStartSec=60
ExecStart=-/usr/bin/systemctl disable --now cia-j1-n50-ws.timer
ExecStartPost=/usr/bin/systemctl enable --now cia-j1-rest-hourly.timer
