# J1/D295: OFF BY DEFAULT; DO NOT INSTALL/START without production release gate.
# The installed N2 REST timer/service must be INACTIVE before running this unit.
[Unit]
Description=CIA J1 N50 bounded managed closed-hour research (NO TRADING)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=@OWNER@
WorkingDirectory=@REPO@
UMask=0077
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStartPre=@PYTHON@ -m scripts.preflight_j1_n50_systemd_isolation --require-n2-quiesced
ExecStart=@PYTHON@ -m scripts.run_j1_n50_managed_once --root-directory @ROOT@ --allow-public-network --allow-private-storage --allow-private-manifest-read --allow-private-readonly-audit --allow-private-manifest-write --confirm-region-and-personal-research --enable-managed-n50-tick
TimeoutStartSec=900
Restart=no
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=@ROOT@
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
StandardOutput=journal
StandardError=journal
