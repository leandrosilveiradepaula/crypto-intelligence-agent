# OPS23 / J1: ONE ABSOLUTE UTC DATE, not an hourly cron; OFF BY DEFAULT.
[Unit]
Description=J1 one-shot bounded UTC-close diagnostic timer (OFF by default)

[Timer]
OnCalendar=@CALENDAR_UTC@
AccuracySec=1s
RandomizedDelaySec=0
Persistent=false
Unit=cia-j1-ops22-once.service

[Install]
WantedBy=timers.target
