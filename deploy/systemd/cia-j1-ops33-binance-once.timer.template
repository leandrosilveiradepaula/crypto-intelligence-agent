# OPS33: exactly one absolute UTC launch; no missed-run catch-up.
[Unit]
Description=OPS33 Binance finite public shadow timer (OFF by default)

[Timer]
OnCalendar=@CALENDAR_UTC@
AccuracySec=1s
RandomizedDelaySec=0
Persistent=false
Unit=cia-j1-ops33-binance-once.service

[Install]
WantedBy=timers.target
