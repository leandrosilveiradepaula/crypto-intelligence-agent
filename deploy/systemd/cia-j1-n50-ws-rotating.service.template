# D321 candidate replacement for cia-j1-n50-ws.service, future release ONLY.
# D320 installed unit uses fixed manifest/cache; do NOT replace it in-place.
# This reads owner-active pointer and independently revalidates D287+D316.
[Unit]
Description=CIA J1 N50 WS preclose from private active 36h cohort (no trades)
Wants=network-online.target
After=network-online.target
OnFailure=cia-j1-n50-ws-fallback.service

[Service]
Type=oneshot
User=@OWNER@
WorkingDirectory=@REPO@
UMask=0077
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStartPre=@PYTHON@ -m scripts.preflight_j1_n50_ws_systemd --require-old-collectors-quiesced
ExecStart=@PYTHON@ -m scripts.run_j1_n50_ws_owner_active_once --state-directory @STATE_DIR@ --allow-private-pointer-read --allow-private-manifest-read --allow-private-ws-scope-read --allow-private-ws-writer --allow-public-websocket --confirm-region-and-personal-research --allow-create-ws-journal
TimeoutStartSec=210
Restart=no
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=@EPOCH_ROOT@
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
StandardOutput=journal
StandardError=journal
