# D322: future owner 36h N50 rotation fallback; OFF by default.
# Root service stops BOTH WS timers before restoring N2.
[Unit]
Description=CIA J1 N50 WS rotating epoch failure rollback to N2
After=cia-j1-n50-ws.service

[Service]
Type=oneshot
User=root
NoNewPrivileges=true
ProtectHome=read-only
ProtectSystem=strict
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX
TimeoutStartSec=60
ExecStart=-/usr/bin/systemctl disable --now cia-j1-n50-ws-rotate.timer
ExecStart=-/usr/bin/systemctl disable --now cia-j1-n50-ws.timer
ExecStartPost=/usr/bin/systemctl enable --now cia-j1-rest-hourly.timer
