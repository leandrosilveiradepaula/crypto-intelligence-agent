# D297: root-owned failback after any N50 managed service failure.
# No database mutation, no trading. Re-enable existing legacy timer only.
[Unit]
Description=CIA J1 return to the previously healthy N2 timer after N50 failure
After=cia-j1-n50-managed.service

[Service]
Type=oneshot
User=root
NoNewPrivileges=true
ProtectHome=read-only
ProtectSystem=strict
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX
TimeoutStartSec=60
ExecStart=-/usr/bin/systemctl disable --now cia-j1-n50-managed.timer
ExecStartPost=/usr/bin/systemctl enable --now cia-j1-rest-hourly.timer
