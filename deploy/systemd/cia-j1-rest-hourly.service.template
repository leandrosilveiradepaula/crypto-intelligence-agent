# J1/M1: OFF BY DEFAULT. Never install/start/enable from GitHub/CI.
[Unit]
Description=CIA J1 bounded closed-UTC-hour Bybit REST research only (NOT trading)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=@OWNER@
WorkingDirectory=@REPO@
UMask=0077
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=@PYTHON@ -m scripts.run_j1_rest_hourly_once --frozen-directory @FROZEN@ --output-directory @OUTPUT@ --max-assets @MAX_ASSETS@ --allow-public-network --allow-private-storage --confirm-region-and-personal-research
TimeoutStartSec=900
Restart=no
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=@OUTPUT@
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
StandardOutput=journal
StandardError=journal
