# D423 RELEASE CANDIDATE ONLY. Local dashboard, never public/mobile ingress.
# The D422 server separately denies DNS rebinding and unapproved HTTP verbs.
[Unit]
Description=CIA local-only read-only N50 health dashboard (not public)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=cia-probe
Group=cia-probe
WorkingDirectory=/home/cia-probe/agent/j5-health-release
UMask=0077
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/home/cia-probe/agent/ws-venv/bin/python -m scripts.serve_j5_local_readonly --allow-loopback-readonly-http --allow-private-health-loopback --private-health-directory /home/cia-probe/agent/j5-n50-health-private
Restart=on-failure
RestartSec=15s
TimeoutStartSec=30
CPUQuota=15%
MemoryMax=256M
TasksMax=64
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/home/cia-probe/agent/j5-n50-health-private
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET
SystemCallArchitectures=native
StandardOutput=journal
StandardError=journal
