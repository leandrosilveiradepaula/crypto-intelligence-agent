# D423 RELEASE CANDIDATE ONLY. Never enable as part of a code merge.
# OnUnitInactiveSec avoids self-overlap; calendar retry recovers failed units.
[Unit]
Description=CIA research - periodic bounded public N50 health checks (no orders)

[Timer]
OnBootSec=2min
OnUnitInactiveSec=45s
OnCalendar=*-*-* *:0/5:30 UTC
AccuracySec=20s
RandomizedDelaySec=0
Persistent=false
Unit=cia-j2-n50-health.service

[Install]
WantedBy=timers.target
